params.threads = 23
params.nodes = 1
params.num_cpus_per_node = 24

process {
    memory = 220.GB
    cpus = 23
    ext.align_mem = '180'
    time = 96.h
    errorStrategy = 'retry'
    maxRetries = 1

    withLabel: 'long_job' {
        time = 120.h
    }
    withLabel: 'small_mem' {
        memory = 16.GB
    }
    withLabel: 'med_mem' {
        memory = 250.GB
    }
    withLabel: 'large_mem' {
        memory = 220.GB
    }
    withLabel: 'single_cpu' {
        ext {
            split_jobs = 1
            threads = 1
        }
        cpus = 1
    }
    withLabel: 'multi_cpu' {
        ext {
            split_jobs = 1
            threads = params.threads
        }
        cpus = params.threads
    }
    withLabel: 'multi_node' {
        ext {
            split_jobs = params.nodes
            threads = 24
        }
        cpus = 24
    }
    withLabel: 'gpx_submitter' {
        ext {
            split_jobs = params.nodes
            threads = 1
        }
        cpus = 1
    }
}
